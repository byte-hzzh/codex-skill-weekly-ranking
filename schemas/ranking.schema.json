{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ranking-1.0.json",
  "type": "object",
  "required": [
    "schema_version", "algorithm_version", "ranking_status", "week",
    "generated_at", "source_observed_at", "complete", "demo", "entries",
    "limitations", "stale_from_week"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "algorithm_version": { "enum": ["weekly-v1", "trial-v1"] },
    "ranking_status": { "enum": ["official", "trial", "stale"] },
    "week": {
      "type": "object",
      "required": ["start_date", "end_date", "timezone"],
      "properties": {
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "timezone": { "const": "Asia/Shanghai" }
      },
      "additionalProperties": false
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_observed_at": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "date-time" }
    },
    "complete": { "type": "boolean" },
    "demo": { "type": "boolean" },
    "stale_from_week": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "rank", "candidate_key", "name", "description", "repository", "path",
          "source_url", "repository_url", "score", "metrics", "components"
        ],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "candidate_key": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "repository": { "type": "string" },
          "path": { "type": "string" },
          "source_url": { "type": "string", "pattern": "^https://github\\.com/" },
          "repository_url": { "type": "string", "pattern": "^https://github\\.com/" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "components": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

