{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/snapshot-1.0.json",
  "type": "object",
  "required": [
    "schema_version", "scheduled_date", "timezone", "observed_at",
    "complete", "repositories", "errors"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scheduled_date": { "type": "string", "format": "date" },
    "timezone": { "const": "Asia/Shanghai" },
    "observed_at": { "type": "string", "format": "date-time" },
    "complete": { "const": true },
    "errors": { "type": "array", "maxItems": 0 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repository_id", "repository_node_id", "repository", "default_branch",
          "default_branch_sha", "stars", "forks", "archived", "visibility",
          "request_status"
        ],
        "properties": {
          "repository_id": { "type": "integer", "minimum": 1 },
          "repository_node_id": { "type": "string" },
          "repository": { "type": "string" },
          "default_branch": { "type": "string" },
          "default_branch_sha": { "type": "string" },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "archived": { "type": "boolean" },
          "visibility": { "type": "string" },
          "request_status": { "enum": ["fresh", "cached"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

